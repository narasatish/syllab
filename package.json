{
  "name": "padhj-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "build:mocks": "node scripts/generate-mocks.mjs",
    "build:prerender": "node scripts/generate-prerender.mjs",
    "build:og": "node scripts/generate-og-image.mjs",
    "blog:generate": "node scripts/generate-trending-blogs.mjs",
    "build:rss": "node scripts/generate-rss.mjs",
    "ping:search": "node scripts/ping-search-engines.mjs",
    "build:decks": "node scripts/ingest-story-decks.mjs",
    "build": "node scripts/ingest-story-decks.mjs && node scripts/generate-og-image.mjs && node scripts/generate-app-icons.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-image-sitemap.mjs && node scripts/generate-trending-blogs.mjs && node scripts/generate-rss.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/generate-prerender.mjs && node scripts/audit-seo.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "test": "node scripts/audit-seo.mjs && vitest run",
    "test:watch": "vitest",
    "test:seo": "node scripts/audit-seo.mjs",
    "test:run": "vitest run",
    "newsletter:send": "node scripts/send-weekly-newsletter.mjs",
    "newsletter:dry-run": "DRY_RUN=true node scripts/send-weekly-newsletter.mjs",
    "mocks:generate-state": "python3 scripts/generate_all_mocks.py",
    "ig:run": "node scripts/instagram-bot/run-daily.mjs",
    "ig:dry": "node scripts/instagram-bot/run-daily.mjs --dry",
    "ig:post": "node scripts/instagram-bot/post-daily.mjs",
    "reddit:post": "node scripts/reddit-bot/post-reddit.mjs",
    "reddit:dry-run": "node scripts/reddit-bot/post-reddit.mjs --dry-run",
    "reddit:open": "node scripts/reddit-bot/open-reddit-posts.mjs",
    "mcq:generate": "tsx scripts/generate-mcqs.ts",
    "growth:daily": "node scripts/growth-agent.mjs",
    "growth:post": "node scripts/growth-agent.mjs --post",
    "chapters:export": "tsx scripts/export-chapters.ts",
    "slides:generate": "tsx scripts/generate-slides.ts",
    "decks:import": "tsx scripts/import-decks.ts",
    "ig:preview": "node -e \"process.env.DRY_RUN='true'; import('./scripts/instagram-bot/post-daily.mjs')\"",
    "ig:preview-puzzle": "node -e \"process.env.DRY_RUN='true'; process.argv.push('--type=puzzle'); import('./scripts/instagram-bot/post-daily.mjs')\"",
    "build:images": "node scripts/generate-image-sitemap.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.1",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^4.22.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "globals": "^17.5.0",
    "heic2any": "^0.0.4",
    "jsdom": "^29.0.2",
    "katex": "^0.16.45",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "ffmpeg-static": "^5.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}

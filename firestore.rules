rules_version = '2';

// Syllab Firestore Security Rules v3
// Changes from v2:
//   • users: allow extended profile fields (personal, learning, parent, selectedAvatarId, etc.)
//   • users: allow parent to update only parentId on a child doc
//   • parentRequests: new collection for child→parent invitation flow
//   • Keep monotonic XP/score, immutable createdAt

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- USERS ----------
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Core stats validation (only checked when the fields are present)
      function statsValid(d) {
        return (!('score' in d) || (d.score is number && d.score >= 0))
            && (!('xp'    in d) || (d.xp    is number && d.xp    >= 0))
            && (!('rank'  in d) || d.rank is string)
            && (!('streak' in d) || (d.streak is number && d.streak >= 0));
      }

      // Stats must not regress on updates
      function noStatRegression() {
        return (!('score' in resource.data) || !('score' in request.resource.data) || request.resource.data.score >= resource.data.score)
            && (!('xp' in resource.data)    || !('xp'    in request.resource.data) || request.resource.data.xp    >= resource.data.xp);
      }

      // createdAt must not change
      function createdAtPreserved() {
        return !('createdAt' in resource.data)
            || !('createdAt' in request.resource.data)
            || request.resource.data.createdAt == resource.data.createdAt;
      }

      // Any authenticated user can read a user doc (parent dashboard needs this)
      allow read: if request.auth != null;

      // Owner creates their own doc
      allow create: if isOwner()
          && statsValid(request.resource.data);

      // Owner updates their own doc
      allow update: if isOwner()
          && statsValid(request.resource.data)
          && noStatRegression()
          && createdAtPreserved();

      // A parent can update ONLY the parentId field on a child doc
      allow update: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentId', 'updatedAt'])
          && (request.resource.data.parentId == request.auth.uid
              || request.resource.data.parentId == null);

      allow delete: if false;
    }

    // ---------- PROGRESS ----------
    // Aggregate per-user progress summary (totalXP, counters, last activity).
    // Read: owner OR any authenticated user (parent dashboard onSnapshot).
    // Write: owner only.
    match /progress/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if request.auth != null;
      allow create, update: if isOwner() && request.resource.data.size() < 200;
      allow delete: if false;
    }

    // ---------- ACTIVITY EVENTS ----------
    // One row per completed learning session (Daily Dose, Practice, Olympiad,
    // Mock/Exam, PPT, Skill Lab). Used by Progress page + Parent Hub feed.
    // Read: any authenticated user (parent needs to query by child uid).
    // Create: owner only — uid must match request.auth.uid.
    match /activityEvents/{eventId} {
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---------- USER ACTIVITIES (legacy — kept for backward read compat) ----------
    // New code uses activityEvents above; this is read-only fallback.
    match /userActivities/{docId} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---------- MISTAKES ----------
    match /mistakes/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'userId', 'questionId', 'chapterId', 'subject',
             'questionText', 'selectedOption', 'correctOption', 'timestamp'
           ])
        && request.resource.data.keys().hasAll([
             'userId', 'questionId', 'questionText', 'timestamp'
           ])
        && request.resource.data.questionText is string
        && request.resource.data.questionText.size() <= 5000
        && request.resource.data.timestamp == request.time;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- USER PREFS (pinned chapters etc.) ----------
    match /userPrefs/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, create, update: if isOwner();
      allow delete: if false;
    }

    // ---------- QUIZ SESSIONS ----------
    match /quizSessions/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.userId == userId;
      allow delete: if false;
    }

    // ---------- DAILY CHALLENGES ----------
    match /dailyChallengeProfiles/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'attempts', 'bestScore', 'totalScore',
          'participation', 'updatedAt'
        ])
        && request.resource.data.size() < 200
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /dailyChallengeLeaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'category', 'classLevel',
          'score', 'total', 'secondsLeft', 'durationSeconds', 'date',
          'points', 'completedAt', 'updatedAt'
        ])
        && request.resource.data.score is number
        && request.resource.data.total is number
        && request.resource.data.secondsLeft is number
        && request.resource.data.durationSeconds is number
        && request.resource.data.points is number
        && request.resource.data.completedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- CONTACTS ----------
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- AI CACHE ----------
    match /aiCache/{docId} {
      allow read, write: if false;
    }

    // ---------- SHARED PPT LESSONS (cache-first AI lessons) ----------
    // Lessons are deterministic per (class, subject, chapter) — any user
    // who fetched and validated one can populate the cache for everyone.
    // Doc IDs look like "10_Science_chapter-2-acids-bases-and-salts".
    match /shared_ppt_lessons_v4/{lessonKey} {
      // Read: any authenticated user
      allow read: if request.auth != null;
      // Write: any authenticated user, but only with a real lesson
      //   • slides array with >= 10 entries
      //   • not flagged as a fallback
      //   • payload under Firestore's 1 MiB doc limit (capped at 500 KB here)
      allow create, update: if request.auth != null
          && request.resource.data.slides is list
          && request.resource.data.slides.size() >= 10
          && (!('isFallback' in request.resource.data) || request.resource.data.isFallback == false)
          && (!('quality' in request.resource.data) || request.resource.data.quality != 'quick_fallback');
      allow delete: if false;
    }

    // ---------- PARENT LINKS ----------
    match /parents/{parentUid} {
      allow read, write: if request.auth != null && request.auth.uid == parentUid;
    }

    // ---------- PARENT REQUESTS ----------
    // Child sends an invitation to their parent's email.
    // Status: pending → accepted | rejected
    match /parentRequests/{requestId} {
      // Child creates the request
      allow create: if request.auth != null
          && request.resource.data.childUid == request.auth.uid
          && request.resource.data.keys().hasAll([
               'childUid', 'childEmail', 'childName',
               'parentEmailLower', 'status', 'createdAt', 'updatedAt'
             ])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

      // Anyone authenticated can read (child checks their own; parent checks by email)
      allow read: if request.auth != null;

      // Child or parent can update status (accept/reject)
      allow update: if request.auth != null
          && (resource.data.childUid == request.auth.uid
              || resource.data.parentEmailLower == request.auth.token.email.lower());

      allow delete: if false;
    }

    // ---------- EXAM CODES ----------
    // Parent/teacher creates a code; any logged-in user can read to join
    match /examCodes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && request.resource.data.keys().hasAll(['class', 'subjects', 'level', 'count'])
          && request.resource.data.count is number
          && request.resource.data.count <= 100;
      allow delete: if false;
    }

    // ---------- EXAM RESULTS ----------
    // Written by student after completing a live/custom exam.
    // Readable by anyone authenticated (parent needs to query by child userId).
    match /examResults/{resultId} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'title', 'score', 'total', 'completedAt'])
          && request.resource.data.score is number
          && request.resource.data.total is number
          && request.resource.data.completedAt == request.time;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---------- NEWSLETTERS ----------
    // Subscribers can create their own subscription directly from the client.
    // No reads/updates/deletes from client — admin SDK handles those.
    match /newsletters/{docId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'subscribedAt'])
          && request.resource.data.keys().hasOnly(['email', 'classLevel', 'role', 'active', 'subscribedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.email.size() <= 200
          && request.resource.data.subscribedAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- LIVE QUIZ (Kahoot-style multiplayer) ----------
    // Game doc id = 6-digit PIN. Host must be authenticated to create/control
    // the game; players join PIN-only with just a nickname (no account), like
    // Kahoot. Game state is public-readable so joined players can render it.
    match /liveQuizzes/{pin} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.status == 'lobby'
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 50;
      // Only the host advances the game.
      allow update: if request.auth != null
          && resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      // Players: PIN-only writes, strictly validated + capped.
      match /players/{playerId} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 24
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= 100000;
        allow delete: if false;
      }
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

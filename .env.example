# =====================================================================
# Frontend env - these are bundled into the JS that ships to every user.
# Only values safe to be PUBLIC belong here.
# =====================================================================

# Firebase web config - public identifiers, safe to commit.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Optional: only if you use a non-default Firestore database ID.
# VITE_FIREBASE_DATABASE_ID=ai-studio-xxxxxxxx

# Backend API URL. In production, set this to your deployed backend.
VITE_API_BASE_URL=https://YOUR_BACKEND_DOMAIN_HERE

# Feature flags.
VITE_FIREBASE_AUTH_ENABLED=true
VITE_FIRESTORE_FEATURES=false

# For local development only.
# VITE_API_URL=http://localhost:5000

# =====================================================================
# Do not set VITE_GEMINI_API_KEY here. Any VITE_* value is public.
# Keep Gemini, Resend, and Firebase Admin credentials on the backend only.
# =====================================================================

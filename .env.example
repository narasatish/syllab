# =====================================================================
# Frontend env - these are bundled into the JS that ships to every user.
# Only values safe to be PUBLIC belong here.
# =====================================================================

# Firebase web config - public identifiers, safe to commit.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Optional: only if you use a non-default Firestore database ID.
# VITE_FIREBASE_DATABASE_ID=ai-studio-xxxxxxxx

# Backend API URL. In production, set this to your deployed backend.
VITE_API_BASE_URL=https://YOUR_BACKEND_DOMAIN_HERE

# Feature flags.
VITE_FIREBASE_AUTH_ENABLED=true
VITE_FIRESTORE_FEATURES=false

# For local development only.
# VITE_API_URL=http://localhost:5000

# =====================================================================
# Backend-only secrets (NEVER use VITE_ prefix)
# =====================================================================

# Resend API key for sending emails (weekly newsletter)
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=your_resend_api_key_here

# Firebase Admin SDK service account
# Download from Firebase Console > Project Settings > Service Accounts
# Either set as JSON string or path to JSON file:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
# OR
# FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/serviceAccountKey.json

# Newsletter configuration
# NEWSLETTER_FROM_EMAIL=support@syllab.in

# =====================================================================
# Do not set VITE_GEMINI_API_KEY here. Any VITE_* value is public.
# Keep Gemini, Resend, and Firebase Admin credentials on the backend only.
# =====================================================================

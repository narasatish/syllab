{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://syllab-backend.onrender.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/syllabus", "destination": "/index.html" },
      { "source": "/class-11", "destination": "/index.html" },
      { "source": "/class-12", "destination": "/index.html" },
      { "source": "/practice", "destination": "/index.html" },
      { "source": "/daily-challenges", "destination": "/index.html" },
      { "source": "/mock-tests", "destination": "/index.html" },
      { "source": "/progress", "destination": "/index.html" },
      { "source": "/analytics", "destination": "/index.html" },
      { "source": "/learning-lab", "destination": "/index.html" },
      { "source": "/study-arena", "destination": "/index.html" },
      { "source": "/scan", "destination": "/index.html" },
      { "source": "/preparation", "destination": "/index.html" },
      { "source": "/profile", "destination": "/index.html" },
      { "source": "/about", "destination": "/index.html" },
      { "source": "/contact", "destination": "/index.html" },
      { "source": "/sitemap", "destination": "/index.html" },
      { "source": "/privacy", "destination": "/index.html" },
      { "source": "/terms", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" }
    ]
  }
}

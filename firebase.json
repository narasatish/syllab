        "destination": "/gk-quiz",
        "type": 301
      },
      {
        "source": "/exams",
        "destination": "/mock-tests",
        "type": 301
      },
      {
        "source": "/exams/",
        "destination": "/mock-tests",
        "type": 301
      },
      {
        "source": "/learning-lab",
        "destination": "/ai-tutor",
        "type": 301
      },
      {
        "source": "/learning-lab/",
        "destination": "/ai-tutor",
        "type": 301

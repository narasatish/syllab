        "destination": "/ncert-solutions/class-10/chemistry/acids-bases-and-salts",
        "type": 301
      },
      {
        "source": "/ncert-solutions/class-10/science/chemical-equations",
        "destination": "/ncert-solutions/class-10/chemistry/chemical-reactions-and-equations",
        "type": 301
      },
      {
        "source": "/ncert-solutions/class-10/science/reflection-of-light-at-curved-surfaces",
        "destination": "/ncert-solutions/class-10/physics/light-reflection-and-refraction",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob: https://cdn.pixabay.com https://*.pixabay.com https:; connect-src 'self' https://accounts.google.com https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://syllab-backend.onrender.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains"
          }
        ]
      },
      {
        "//": "HTML must revalidate. The /index.html rule below never fires: cleanUrls means a page is requested as /gk-questions, not /gk-questions/index.html, so every prerendered page was served max-age=3600 and a reader could get an hour-stale page after a deploy. This rule matches everything; the immutable rule that follows overrides it for hashed assets.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "robots.txt and sitemap.xml get a real TTL so the CDN answers them. The blanket max-age=0 rule above forces a revalidation to origin on EVERY fetch, and robots.txt is the one file where an origin blip is catastrophic: a 5xx or timeout there stops Googlebot crawling the WHOLE site, which is what happened on 16-17 August 2026 (zero crawl requests for two days, then a ~40-position drop). Google re-reads robots.txt about once a day, so an hour of edge caching costs nothing and removes almost all origin exposure.",
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/profile",
        "destination": "/index.html"
      },
      {
        "source": "/profile/**",
        "destination": "/index.html"
      },
      {
        "source": "/parent",
        "destination": "/index.html"
      },
      {
        "source": "/parent/**",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/index.html"
      },
      {
        "source": "/sitemap",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "ai-studio-868e857b-004a-46b8-805c-01de7314e6e4",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

        "headline": "Significant Figures",
        "sub": "Non-zero digits + zeros between them"
      }
    ]
  },
  {
    "chapter": "Motion in a Straight Line",
    "subject": "Physics",
    "class": 11,
    "cover": "Motion in a Straight Line — every Class 11 formula (save this)",
    "slides": [
      {
        "headline": "Velocity",
        "sub": "v = Δs/Δt (change in displacement/time)"
      },
      {
        "headline": "Acceleration",
        "sub": "a = Δv/Δt (change in velocity/time)"
      },
      {
        "headline": "First Equation of Motion",
        "sub": "v = u + at"
      },
      {
        "headline": "Second Equation of Motion",
        "sub": "s = ut + ½at²"
      },
      {
        "headline": "Third Equation of Motion",
        "sub": "v² − u² = 2as"
      },
      {
        "headline": "Average Velocity",
        "sub": "v_avg = (u + v)/2"
      },
      {
        "headline": "Relative Velocity",
        "sub": "v_AB = v_A − v_B"
      }
    ]
  },
  {
    "chapter": "Laws of Motion",
    "subject": "Physics",
    "class": 11,
    "cover": "Laws of Motion — every Class 11 formula (save this)",
    "slides": [
      {
        "headline": "Newton's First Law",
        "sub": "Object stays at rest/motion unless force applied"
      },
      {
        "headline": "Newton's Second Law",
        "sub": "F = ma (force = mass × acceleration)"
      },
      {
        "headline": "Newton's Third Law",
        "sub": "Action = −Reaction (equal & opposite)"
      },
      {
        "headline": "Momentum",
        "sub": "p = mv"
      },
      {
        "headline": "Impulse",
        "sub": "J = FΔt = Δp"
      },
      {
        "headline": "Friction Force",
        "sub": "f = μN (friction coeff. × normal force)"
      },
      {
        "headline": "Tension in Rope",
        "sub": "T = m(g ± a)"
      }
    ]
  },
  {
    "chapter": "Work Energy Power",
    "subject": "Physics",
    "class": 11,
    "cover": "Work Energy Power — every Class 11 formula (save this)",
    "slides": [
      {
        "headline": "Work",
        "sub": "W = F·s·cosθ (force × displacement × cosine)"
      },
      {
        "headline": "Kinetic Energy",
        "sub": "K.E = ½mv²"
      },
      {
        "headline": "Potential Energy",
        "sub": "P.E = mgh"
      },
      {
        "headline": "Work-Energy Theorem",
        "sub": "W_net = ΔK.E"
      },
      {
        "headline": "Power",
        "sub": "P = W/t (work/time, in watts)"
      },
      {
        "headline": "Mechanical Energy",
        "sub": "E_total = K.E + P.E (constant in isolation)"
      },
      {
        "headline": "Elastic Potential Energy",
        "sub": "U = ½kx² (spring constant × compression²)"
      }
    ]
  },
  {
    "chapter": "Gravitation",
    "subject": "Physics",
    "class": 11,
    "cover": "Gravitation — every Class 11 formula (save this)",
    "slides": [
      {
        "headline": "Newton's Gravitational Law",
        "sub": "F = G(m₁m₂)/r²"
      },
      {
        "headline": "Gravitational Constant",
        "sub": "G = 6.67 × 10⁻¹¹ N·m²/kg²"
      },
      {
        "headline": "Gravitational Field",
        "sub": "I = F/m = GM/r²"
      },
      {
        "headline": "Gravitational Potential",
        "sub": "V = −GM/r"
      },
      {
        "headline": "Escape Velocity",
        "sub": "v_e = √(2GM/R) = √(2gR)"
      },
      {
        "headline": "Orbital Velocity",
        "sub": "v_o = √(GM/r)"
      },
      {
        "headline": "Kepler's Third Law",
        "sub": "T² ∝ r³ (period² proportional to radius³)"
      }
    ]
  },
  {
    "chapter": "Thermodynamics",
    "subject": "Physics",
    "class": 11,
    "cover": "Thermodynamics — every Class 11 formula (save this)",
    "slides": [
      {

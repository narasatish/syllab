    "subject": "Chemistry",
    "class": 11,
    "cover": "Thermodynamics — Class 11 Chemistry (save this)",
    "slides": [
      {
        "headline": "Enthalpy",
        "sub": "H = U + PV"
      },
      {
        "headline": "Enthalpy Change",
        "sub": "ΔH = ΔU + ΔnRT"
      },
      {
        "headline": "Hess's Law",
        "sub": "ΔH_reaction = Σ ΔH_products − Σ ΔH_reactants"
      },
      {
        "headline": "Internal Energy Change",
        "sub": "ΔU = q − w"
      },
      {
        "headline": "Specific Heat Capacity",
        "sub": "q = mcΔT"
      },
      {
        "headline": "Entropy",
        "sub": "ΔS = q_rev/T"

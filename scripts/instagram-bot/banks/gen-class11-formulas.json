        "headline": "pH + pOH",
        "sub": "pH + pOH = 14 (at 25°C)"
      }
    ]
  },
  {
    "chapter": "Sets",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Sets — Class 11 (save this)",
    "slides": [
      {
        "headline": "Union of Sets",
        "sub": "A ∪ B = {x | x ∈ A or x ∈ B}"
      },
      {
        "headline": "Intersection of Sets",
        "sub": "A ∩ B = {x | x ∈ A and x ∈ B}"
      },
      {
        "headline": "Complement of Set",
        "sub": "A' = {x | x ∈ U and x ∉ A}"
      },
      {
        "headline": "De Morgan's Law 1",
        "sub": "(A ∪ B)' = A' ∩ B'"
      },
      {
        "headline": "De Morgan's Law 2",
        "sub": "(A ∩ B)' = A' ∪ B'"
      },
      {
        "headline": "Cardinality",
        "sub": "n(A ∪ B) = n(A) + n(B) − n(A ∩ B)"
      }
    ]
  },
  {
    "chapter": "Trigonometric Functions",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Trigonometric Functions — Class 11 (save this)",
    "slides": [
      {
        "headline": "Sine Function",
        "sub": "sinθ = opposite/hypotenuse"
      },
      {
        "headline": "Cosine Function",
        "sub": "cosθ = adjacent/hypotenuse"
      },
      {
        "headline": "Tangent Function",
        "sub": "tanθ = sinθ/cosθ = opposite/adjacent"
      },
      {
        "headline": "Pythagorean Identity",
        "sub": "sin²θ + cos²θ = 1"
      },
      {
        "headline": "Double Angle: Sine",
        "sub": "sin(2θ) = 2sinθ cosθ"
      },
      {
        "headline": "Double Angle: Cosine",
        "sub": "cos(2θ) = cos²θ − sin²θ"
      },
      {
        "headline": "Double Angle: Tangent",
        "sub": "tan(2θ) = 2tanθ/(1 − tan²θ)"
      }
    ]
  },
  {
    "chapter": "Sequences and Series",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Sequences and Series — Class 11 (save this)",
    "slides": [
      {
        "headline": "Arithmetic Progression",
        "sub": "a_n = a + (n−1)d"
      },
      {
        "headline": "Sum of AP",
        "sub": "S_n = (n/2)(2a + (n−1)d)"
      },
      {
        "headline": "Geometric Progression",
        "sub": "a_n = ar^(n−1)"
      },
      {
        "headline": "Sum of GP",
        "sub": "S_n = a(r^n − 1)/(r − 1)"
      },
      {
        "headline": "Infinite GP Sum",
        "sub": "S_∞ = a/(1−r) when |r| < 1"
      },
      {
        "headline": "Arithmetic Mean",
        "sub": "AM = (a + b)/2"
      },
      {
        "headline": "Geometric Mean",
        "sub": "GM = √(ab)"
      }
    ]
  },
  {
    "chapter": "Straight Lines",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Straight Lines — Class 11 (save this)",
    "slides": [
      {
        "headline": "Slope of Line",
        "sub": "m = (y₂ − y₁)/(x₂ − x₁)"
      },
      {
        "headline": "Point-Slope Form",
        "sub": "y − y₁ = m(x − x₁)"
      },
      {
        "headline": "Slope-Intercept Form",
        "sub": "y = mx + c"
      },
      {
        "headline": "General Form",
        "sub": "ax + by + c = 0"
      },
      {
        "headline": "Distance Between Points",
        "sub": "d = √((x₂ − x₁)² + (y₂ − y₁)²)"
      },
      {
        "headline": "Distance Point to Line",
        "sub": "d = |ax₀ + by₀ + c|/√(a² + b²)"
      },
      {
        "headline": "Angle Between Lines",
        "sub": "tanθ = |(m₁ − m₂)/(1 + m₁m₂)|"
      }
    ]
  },
  {
    "chapter": "Limits and Derivatives",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Limits and Derivatives — Class 11 (save this)",
    "slides": [
      {
        "headline": "Limit Definition",
        "sub": "lim(x→a) f(x) = L"
      },
      {
        "headline": "Limit Laws: Addition",
        "sub": "lim(f+g) = lim(f) + lim(g)"
      },
      {
        "headline": "Derivative Definition",
        "sub": "f'(x) = lim(h→0) [f(x+h)−f(x)]/h"
      },
      {
        "headline": "Power Rule",
        "sub": "d/dx(x^n) = nx^(n−1)"
      },
      {
        "headline": "Constant Rule",
        "sub": "d/dx(c) = 0"
      },
      {
        "headline": "Sum Rule",
        "sub": "d/dx(f+g) = f'(x) + g'(x)"
      },
      {
        "headline": "Product Rule",
        "sub": "d/dx(fg) = f·g' + g·f'"
      }
    ]
  },
  {
    "chapter": "Permutations and Combinations",
    "subject": "Mathematics",
    "class": 11,
    "cover": "Permutations and Combinations — Class 11 (save this)",
    "slides": [
      {
        "headline": "Factorial",
        "sub": "n! = n × (n−1) × (n−2) × ... × 1"
      },
      {
        "headline": "Permutations",
        "sub": "P(n,r) = n!/(n−r)!"
      },
      {
        "headline": "Combinations",
        "sub": "C(n,r) = n!/(r!(n−r)!)"
      },
      {
        "headline": "Permutation Property",
        "sub": "P(n,r) = r! × C(n,r)"
      },
      {
        "headline": "Circular Permutations",
        "sub": "P = (n−1)!"
      },
      {
        "headline": "Pascal's Identity",
        "sub": "C(n,r) = C(n−1,r−1) + C(n−1,r)"
      }
    ]
  }

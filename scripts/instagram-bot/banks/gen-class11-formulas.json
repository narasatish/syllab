        "sub": "C = Q/ΔT"
      },
      {
        "headline": "Specific Heat",
        "sub": "c = Q/(mΔT)"
      },
      {
        "headline": "Temperature Conversion",
        "sub": "°C = (°F − 32) × 5/9"
      },
      {
        "headline": "Thermal Expansion (Linear)",
        "sub": "ΔL = αL₀ΔT"
      },
      {
        "headline": "Thermal Expansion (Volume)",
        "sub": "ΔV = γV₀ΔT"
      },
      {
        "headline": "First Law Thermodynamics",
        "sub": "ΔU = Q − W (internal energy change)"
      },
      {
        "headline": "Work in Isothermal Process",
        "sub": "W = nRT × ln(V_f/V_i)"
      }
    ]
  },
  {
